<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtNomeJogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="NOME DO JOGO"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imgJogo" />

        <TextView
            android:id="@+id/txtStatusJogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Disponível"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/txtNomeJogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imgJogo" />

        <Button
            android:id="@+id/btnAlugar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALUGAR"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#000000"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/txtStatusJogo"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/imgJogo"
            android:layout_width="100dp"
            android:layout_height="134dp"
            android:src="@drawable/uno"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Capa do Jogo" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
