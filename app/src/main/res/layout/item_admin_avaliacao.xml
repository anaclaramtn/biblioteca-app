<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_comentario"
    android:layout_margin="8dp">

    <!-- TOPO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtNomeUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Usuário"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24/07/2025"
            android:textColor="#777"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- ESTRELAS -->
    <TextView
        android:id="@+id/txtEstrelas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐⭐⭐⭐☆"
        android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <!-- TÍTULO DA AVALIAÇÃO -->
    <TextView
        android:id="@+id/txtTituloAvaliacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título da Avaliação"
        android:textStyle="bold"
        android:textColor="#000"
        android:layout_marginTop="8dp"/>

    <!-- COMENTÁRIO -->
    <TextView
        android:id="@+id/txtComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Esse é um resenha..."
        android:textColor="#555"
        android:layout_marginTop="4dp"/>

    <!-- AÇÕES -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <ImageButton
            android:id="@+id/btnCurtir"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_heart"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/txtCurtidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnCurtir"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:text="0"
            android:textColor="#555"
            android:textSize="12sp"/>

        <!-- MENU ADMIN (3 PONTOS) -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_trespontos"
            app:tint="@android:color/black"/>
    </RelativeLayout>

</LinearLayout>