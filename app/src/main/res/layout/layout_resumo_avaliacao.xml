<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/lblTituloAvaliacoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avaliações"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/txtTotalAvaliacoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0 avaliações)"
            android:textColor="#555555"
            android:layout_alignParentEnd="true"
            android:layout_alignBaseline="@id/lblTituloAvaliacoes"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_moldura_avaliacao"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0"
            android:textSize="32sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginEnd="24dp"/>

        <TextView
            android:id="@+id/txtEstrelasMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☆☆☆☆☆"
            android:textSize="24sp" />

    </LinearLayout>

</LinearLayout>